# 이 파일을 복사해 이름을 .env 로 바꾸면 설정을 바꿀 수 있습니다. (없으면 아래 기본값)
# ※ API 키는 여기 넣지 마세요.  python main.py setkey  로 등록하면 암호화돼 저장됩니다.

# 특정 광고주만 (로그인ID 또는 CUSTOMER_ID, 쉼표 구분). 비우면 연결된 광고주 전체
ACCOUNTS=

# 화면 상단에 표시할 담당자 이름
OWNER_NAME=

# 처음 실행할 때 과거 성과를 받아올 일수
BACKFILL_DAYS=35
# 변경 전/후 비교 기간(일)
WINDOW_DAYS=7
# 화면에 보여줄 변경 기간(일)
REPORT_DAYS=60
# 성장/하락 판정 기준(%)
THRESHOLD_PCT=15
# 전환 종류 (purchase=구매완료). 비우면 모든 전환
CONV_TYPES=purchase
# 동시에 처리할 광고주 수 (API 제한에 걸리면 줄이세요)
WORKERS=3

# 광고주를 가져올 관리계정 번호(쉼표). 비우면 내가 OWNER인 관리계정 전체
MANAGER_ACCOUNT_NOS=
# 관리계정 밖에서 직접 권한 받은 검색광고 계정도 포함하려면 1
INCLUDE_DIRECT_ACCOUNTS=0
# 변경 전후 클릭 합이 이보다 적으면 판정 보류
MIN_CLICKS=30
